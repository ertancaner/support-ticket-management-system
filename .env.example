# ==========================================
# DESTEK TALEBİ YÖNETİM SİSTEMİ ORTAM DEĞİŞKENLERİ
# ==========================================

# ------------------------------------------
# Veritabanı (PostgreSQL) Yapılandırması
# ------------------------------------------
POSTGRES_DB=ticket_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretPostgresPassword123!
POSTGRES_PORT=5432

# Backend için Connection String (Docker container içi kullanımda host: postgres)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=ticket_management_db;Username=postgres;Password=SuperSecretPostgresPassword123!

# ------------------------------------------
# İlk Admin Hesabı (Seed) Yapılandırması
# ------------------------------------------
ADMIN_USERNAME=admin
ADMIN_TEMP_PASSWORD=AdminTempPassword123!

# ------------------------------------------
# JWT ve Güvenlik Yapılandırması
# ------------------------------------------
JWT_SECRET_KEY=SuperSecretKeyForTicketManagementSystemMustBeAtLeast32CharactersLong123!
JWT_ISSUER=TicketManagementApi
JWT_AUDIENCE=TicketManagementClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ------------------------------------------
# CORS & İstemci Yapılandırması
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------
# Port Yapılandırmaları (Host Makine)
# ------------------------------------------
PORT_BACKEND=5001
PORT_FRONTEND=3000
